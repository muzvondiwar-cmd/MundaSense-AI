# All paths are resolved relative to the repository root when not absolute.
MUNDASENSE_DATA_PATH=data/sample/maize_demo.csv
MUNDASENSE_MODEL_PATH=models/mundasense_demo_v1.joblib
MUNDASENSE_DATABASE_PATH=data/local/mundasense.sqlite3
MUNDASENSE_DEFAULT_LOCALE=en
MUNDASENSE_RANDOM_SEED=42
MUNDASENSE_LOG_LEVEL=INFO
MUNDASENSE_DEMO_BANNER=true
MUNDASENSE_EXTENSION_CONTACT=Contact your local agricultural extension office.
# Comma-separated exact origins. The local Vite defaults are allowed when unset.
MUNDASENSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
